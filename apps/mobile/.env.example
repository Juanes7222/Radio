# URL de la API del Backend (sin barra al final)
# Local: http://10.0.2.2:3001 (Simulador Android) o http://<TU_IP_LOCAL>:3001
# Producción: https://api.tu-radio.com
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:3001
EXPO_PUBLIC_FIREBASE_CONFIG={"..."}

# URL publica de la web donde estan las paginas legales (terminos, privacidad,
# tratamiento de datos, cookies). Si la web y el backend comparten dominio,
# esta variable puede omitirse.
EXPO_PUBLIC_WEB_URL=https://www.tu-radio.com