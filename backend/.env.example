# ── Infisical (optional) ───────────────────────────────────────
# Fill these in to load secrets from Infisical at runtime.
# Leave them empty or commented to use only local .env values.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_SECRET_PATH=/

# ── Server ─────────────────────────────────────────────────────
PORT=3000

# ── AzuraCast ───────────────────────────────────────────────────
AZURACAST_URL=http://localhost:8080
AZURACAST_STATION_ID=la_voz_de_la_verdad
AZURACAST_PLAYLIST_ID=12
AZURACAST_NEWS_PLAYLIST_ID=12

# ── Public / Frontend URLs ─────────────────────────────────────
PUBLIC_URL=https://www.lavozverdad.com
FRONTEND_URL=https://www.lavozverdad.com,http://192.168.1.4:5173

# ── Firebase Admin ──────────────────────────────────────────────
# JSON string de la service account de Firebase (con escape de comillas).
# Se usa para verificar tokens de Firebase Auth y para enviar FCM.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Admin Whitelist ────────────────────────────────────────────
ADMIN_WHITELIST=admin1@example.com,admin2@example.com

# ── Zone auto-detection (IP geolocation) ────────────────────────
# Devices without a manual zone get one automatically from their public IP
# (city, falling back to region). Uses ip-api.com free tier by default (no
# API key). Only the derived zone is stored, never the raw IP.
GEOIP_ENABLED=true
# GEOIP_ENDPOINT=http://ip-api.com/json
# GEOIP_CACHE_TTL_SECONDS=86400
# GEOIP_FAILURE_TTL_SECONDS=600
# GEOIP_TIMEOUT_MS=2500

# ── Workers ────────────────────────────────────────────────────
WS_PORT=3001
JOB_DISPATCH_INTERVAL_MS=2000
WORKER_HEARTBEAT_TIMEOUT_MS=60000

# ── YouTube ────────────────────────────────────────────────────
YOUTUBE_CHANNEL_IDS=UCVqtYvLNHvGymJFoGeRH7nw
MAX_VIDEO_DURATION_SECONDS=600
MAX_RETRY_ATTEMPTS=3

# ── Locutor ────────────────────────────────────────────────────
KOKORO_URL=http://localhost:8880
MEDIA_DIR=/var/azuracast/stations/1/media/locutores
TIMEZONE=America/Bogota
STATION_NAME="La Voz de la Verdad"
# Carpeta con los instrumentales de fondo (relativa al cwd del backend)
LOCUTOR_BEDS_DIR=../packages/assets/audio
# Volumen del instrumental bajo la voz (0.0 - 1.0)
LOCUTOR_BED_VOLUME=0.15
# Avisos por hora en horas seguras (minutos aleatorios)
LOCUTOR_ANNOUNCEMENTS_PER_HOUR=2
# Separación mínima entre avisos dentro de la misma hora (minutos)
LOCUTOR_ANNOUNCEMENT_MIN_GAP_MINUTES=20

# ── Email ──────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=no-reply@lavozverdad.com
# EMAIL_FROM_NAME="La Voz de la Verdad"
# BREVO_API_KEY=
# PRAYER_EMAIL_RECIPIENTS=admin1@example.com,admin2@example.com

# ── Secrets (fallback for local development only) ───────────────
# These should ideally live in Infisical. They are kept here as
# a fallback when INFISICAL_CLIENT_ID is not configured.
# NEVER commit real values to version control.
# AZURACAST_API_KEY=
# JWT_SECRET=
# PANEL_SECRET=
# WORKER_AUTH_SECRET=
# WEBHOOK_SECRET=
# FB_VERIFY_TOKEN=
# FB_APP_SECRET=
