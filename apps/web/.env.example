# [TEMPLATE]
# There are TWO variables, one for the browser and one for the dev server:
#
# VITE_API_BASE_URL is the origin the BROWSER calls. Leave it empty and all
# requests stay relative (same-origin): in development they go through the
# Vite proxy below, in production through nginx. That is the recommended setup
# because it avoids CORS and third-party cookie restrictions (needed by SSE,
# the live relay WebSocket and any cookie-authenticated call).
# Only set it to an absolute URL when the API is a different origin, and add
# this app's origin to the backend ALLOWED_ORIGINS list.
#   Local backend: http://localhost:3000
#   Remote API:    https://api.tu-radio.com
VITE_API_BASE_URL=

# VITE_API_PROXY_TARGET is the backend the VITE DEV SERVER forwards to. It is
# only used by `vite dev`; it never reaches the browser bundle. Point it to the
# local backend to work offline, or to the production domain to test the
# frontend against the real backend:
#   Local:      http://localhost:3000
#   Production: https://www.lavozverdad.com
VITE_API_PROXY_TARGET=http://localhost:3000

# Firebase Web SDK config en JSON (de Firebase Console > Project Settings > Web App)
# Ejemplo: {"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
VITE_FIREBASE_CONFIG=

# (Opcional) "true" muestra la pagina de mantenimiento en lugar de la app
VITE_MAINTENANCE=

# (Opcional) URL del relevo en vivo de DJs. Por defecto se deriva de
# VITE_API_BASE_URL (ws(s)://<backend>/live-relay). Solo se define si el
# WebSocket vive en otro origen.
# VITE_LIVE_RELAY_URL=wss://api.tu-radio.com/live-relay