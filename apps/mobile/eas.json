{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "prebuildCommand": "node scripts/write-google-services.js && npx expo prebuild",
      "node": "22.22.3",
      "pnpm": "10.11.0"
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "prebuildCommand": "node scripts/write-google-services.js && npx expo prebuild",
      "android": {
        "buildType": "apk"
      },
      "node": "22.22.3",
      "pnpm": "10.11.0"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "prebuildCommand": "node scripts/write-google-services.js && npx expo prebuild",
      "node": "22.22.3",
      "pnpm": "10.11.0",
      "env": { "EAS_BUILD_EXPO_DOCTOR": "false" }
    }
  },
  "submit": {
    "production": {}
  }
}