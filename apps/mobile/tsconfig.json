{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // "paths" sin "baseUrl": los valores relativos se resuelven contra el
    // directorio de este tsconfig (TypeScript >= 4.1 y Metro SDK 57 lo soportan).
    "paths": {
      "@/*": [
        "././*"
      ],
      "@assets/*": [
        "../../packages/assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
