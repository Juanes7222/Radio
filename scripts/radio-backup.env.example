# ── Backups · Cloudflare R2 ────────────────────────────────────────
# PRIMARY SOURCE: Infisical. Add these keys to the backend environment in
# Infisical and both the systemd timer (via backend/dist/run-backup.js) and
# the backend itself pick them up automatically — no file needed.
#
# This file (/etc/radio/backup.env, owner root, mode 600) is only a fallback
# for values missing from the environment, useful for local testing.
#
#   sudo mkdir -p /etc/radio
#   sudo cp scripts/radio-backup.env.example /etc/radio/backup.env
#   sudo nano /etc/radio/backup.env
#   sudo chmod 600 /etc/radio/backup.env
#
# The daily systemd timer (scripts/radio-backup.timer) runs
# backend/dist/run-backup.js, which loads Infisical and then executes
# scripts/radio-backup.sh.

# R2 credentials (Cloudflare dashboard → R2 → Manage API tokens).
# The token only needs read/write on the backup bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket that receives the backups (create it once in the dashboard).
R2_BUCKET=radio-backups

# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Optional: object prefix inside the bucket (daily/ and weekly/ go below it).
R2_PREFIX=radio

# Optional: local backup root. Defaults to /var/backups/radio.
# BACKUP_DIR=/var/backups/radio

# Optional: retention windows. Daily keeps the last N daily bundles,
# weekly keeps the last M Sunday bundles. Both apply locally and in R2.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Optional: set to "false" to keep local-only backups (no R2 upload).
# Useful to test retention pruning before wiring credentials.
# BACKUP_UPLOAD_ENABLED=true

# Optional: override the backend checkout path (production default comes
# from scripts/lib.sh: /var/www/radio/backend). Only needed for testing.
# BACKUP_BACKEND_DIR=/var/www/radio/backend

# Optional: where the run log goes. Defaults to /var/log/radio-backup.log.
# BACKUP_LOG_FILE=/var/log/radio-backup.log

# Optional: health endpoint checked after a restore (scripts/radio-restore.sh).
# HEALTH_URL=http://127.0.0.1:3000/health
