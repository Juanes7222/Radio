{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "prebuildCommand": "node scripts/write-google-services.js && npx expo prebuild --clean"
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "prebuildCommand": "node scripts/write-google-services.js && npx expo prebuild --clean",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "prebuildCommand": "node scripts/write-google-services.js && npx expo prebuild --clean",
      "android": {
        "buildProperties": {
          "android.suppressUnsupportedCompileSdk": "36"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}