[TEMPLATE]
# URL base del servidor backend (sin barra al final).
# Es la UNICA variable que define con que servidor se comunica la app web:
# - Datos de reproduccion (/api/nowplaying, /api/schedule, ...)
# - Estado de transmision en vivo (/live-status/stream, SSE)
# - Panel de administracion (/admin-api/...)
# - Peticiones de oracion y busqueda de canciones
# El proxy de Vite en desarrollo tambien la usa, por lo que las rutas
# relativas siempre apuntan al mismo backend.
#
# Local:     http://localhost:3000   (puerto por defecto del backend)
# Produccion: https://api.tu-radio.com  (o vacio si la app y la API comparten
#                                        el mismo dominio detras de un proxy)
VITE_API_BASE_URL=http://localhost:3000

# Firebase Web SDK config en JSON (de Firebase Console > Project Settings > Web App)
# Ejemplo: {"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
VITE_FIREBASE_CONFIG=

# (Opcional) "true" muestra la pagina de mantenimiento en lugar de la app
VITE_MAINTENANCE=
