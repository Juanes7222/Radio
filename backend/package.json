{
  "name": "radio-admin-backend",
  "version": "1.0.0",
  "description": "Intermediario seguro entre el panel admin React y AzuraCast",
  "main": "dist/index.js",
  "scripts": {
    "swagger": "ts-node src/swagger.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:resolve": "prisma migrate resolve",
    "dev": "pnpm run swagger && ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run prisma:generate && pnpm run swagger && tsc"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "@radio/infisical-config": "workspace:*",
    "@radio/types": "workspace:*",
    "axios": "^1.19.0",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.8.0",
    "firebase-admin": "^13.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "maxmind": "^5.0.7",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.4",
    "sharp": "^0.35.3",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "tar": "^7.5.22",
    "ws": "^8.19.0",
    "xml2js": "^0.6.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.20",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
