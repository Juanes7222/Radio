# ── Infisical (optional) ───────────────────────────────────────
# Fill these in to load secrets from Infisical at runtime.
# Leave them empty or commented to use only local .env values.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_SECRET_PATH=/

# ── Server ─────────────────────────────────────────────────────
PORT=3000

# ── AzuraCast ───────────────────────────────────────────────────
AZURACAST_URL=http://localhost:8080
AZURACAST_STATION_ID=la_voz_de_la_verdad
AZURACAST_PLAYLIST_ID=12
AZURACAST_NEWS_PLAYLIST_ID=12

# ── Public / Frontend URLs ─────────────────────────────────────
PUBLIC_URL=https://www.lavozverdad.com
FRONTEND_URL=https://www.lavozverdad.com,http://192.168.1.4:5173

# ── Firebase Admin ──────────────────────────────────────────────
# JSON string de la service account de Firebase (con escape de comillas).
# Se usa para verificar tokens de Firebase Auth y para enviar FCM.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Admin Whitelist ────────────────────────────────────────────
ADMIN_WHITELIST=admin1@example.com,admin2@example.com

# ── Zone auto-detection (IP geolocation) ────────────────────────
# Devices without a manual zone get one automatically from their public IP.
# Primary: MaxMind GeoLite2-City.mmdb local (sin API, sin rate limit).
# Fallback secuencial: ipwho.is -> ipapi.co (solo si MaxMind no resuelve).
# Solo la zona derivada se persiste (city), nunca la IP cruda.
# CGNAT: la IP puede geolocalizar a Bogotá aunque el usuario esté en Cartago;
# por eso la zona auto-asignada es solo estimación inicial y puede corregirse
# manualmente (zoneSource=MANUAL).
GEOIP_ENABLED=true
# Ruta local al .mmdb (requiere cuenta gratuita MaxMind). Si no existe, se
# usa solo el fallback por API.
# GEOIP_MMDB_PATH=./storage/geoip/GeoLite2-City.mmdb
# Auto-actualización MaxMind (mar/vie 03:00 America/Bogota, cuando MaxMind publica).
# Requiere GEOIP_LICENSE_KEY de https://www.maxmind.com/en/geolite2/signup
# GEOIP_UPDATE_ENABLED=false
# GEOIP_LICENSE_KEY=
# GEOIP_ACCOUNT_ID=          # opcional con keys nuevas
# GEOIP_EDITION_ID=GeoLite2-City
# GEOIP_UPDATE_CRON=0 3 * * 2,5
# GEOIP_UPDATE_ON_STARTUP=true
# Solo confiar en headers CF-IPCity si estás detrás de Cloudflare
# GEOIP_TRUST_PROXY_HEADERS=false
# Legacy (ya no recomendado): ip-api.com
# GEOIP_ENDPOINT=http://ip-api.com/json
# GEOIP_IPWHOIS_ENDPOINT=https://ipwho.is
# GEOIP_IPAPICO_ENDPOINT=https://ipapi.co
# GEOIP_CACHE_TTL_SECONDS=86400
# GEOIP_FAILURE_TTL_SECONDS=600
# GEOIP_TIMEOUT_MS=1500

# ── Workers ────────────────────────────────────────────────────
WS_PORT=3001
JOB_DISPATCH_INTERVAL_MS=2000
WORKER_HEARTBEAT_TIMEOUT_MS=60000

# ── YouTube ────────────────────────────────────────────────────
YOUTUBE_CHANNEL_IDS=UCVqtYvLNHvGymJFoGeRH7nw
MAX_VIDEO_DURATION_SECONDS=600
MAX_RETRY_ATTEMPTS=3

# ── Locutor ────────────────────────────────────────────────────
KOKORO_URL=http://localhost:8880
MEDIA_DIR=/var/azuracast/stations/1/media/locutores
TIMEZONE=America/Bogota
STATION_NAME="La Voz de la Verdad"
# Carpeta con los instrumentales de fondo (relativa al cwd del backend)
LOCUTOR_BEDS_DIR=../packages/assets/audio
# Volumen del instrumental bajo la voz (0.0 - 1.0)
LOCUTOR_BED_VOLUME=0.15
# Avisos por hora en horas seguras (minutos aleatorios)
LOCUTOR_ANNOUNCEMENTS_PER_HOUR=2
# Separación mínima entre avisos dentro de la misma hora (minutos)
LOCUTOR_ANNOUNCEMENT_MIN_GAP_MINUTES=20

# ── Email ──────────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=no-reply@lavozverdad.com
# EMAIL_FROM_NAME="La Voz de la Verdad"
# BREVO_API_KEY=
# PRAYER_EMAIL_RECIPIENTS=admin1@example.com,admin2@example.com

# ── Logs · Sala de máquinas (AdminLogs) ───────────────────────
# Rutas y contenedores leídos por /admin-api/logs. Todos opcionales: si no
# existen, la fuente responde vacía con health degraded en lugar de 500.
# Producción (ver ecosistema y scripts/*.sh):
#   PM2_OUT_FILE=/var/log/pm2/radio-backend-out.log
#   PM2_ERROR_FILE=/var/log/pm2/radio-backend-error.log
#   DOCKER_CONTAINER_AZURACAST=azuracast
#   DOCKER_CONTAINER_POSTGRES=postgres  # o DOCKER_CONTAINER_PG
#   NGINX_ACCESS_LOG=/var/log/nginx/access.log
#   NGINX_ERROR_LOG=/var/log/nginx/error.log
#   POSTGRES_LOG_FILE=  # alternativo a docker, archivo nativo
# PM2_OUT_FILE=
# PM2_ERROR_FILE=
# DOCKER_CONTAINER_AZURACAST=azuracast
# DOCKER_CONTAINER_POSTGRES=postgres
# NGINX_ACCESS_LOG=/var/log/nginx/access.log
# NGINX_ERROR_LOG=/var/log/nginx/error.log
# POSTGRES_LOG_FILE=

# ── Secrets (fallback for local development only) ───────────────
# These should ideally live in Infisical. They are kept here as
# a fallback when INFISICAL_CLIENT_ID is not configured.
# NEVER commit real values to version control.
# AZURACAST_API_KEY=
# JWT_SECRET=
# PANEL_SECRET=
# WORKER_AUTH_SECRET=
# WEBHOOK_SECRET=
# FB_VERIFY_TOKEN=
# FB_APP_SECRET=
