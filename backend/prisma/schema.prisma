// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model BibleTranslation {
  id           String      @id @default(uuid())
  abbreviation String      @unique // ej: "RVR60", "NVI"
  name         String      // ej: "Reina Valera 1960"
  books        BibleBook[]
}

model BibleBook {
  id            String           @id @default(uuid())
  translationId String
  translation   BibleTranslation @relation(fields: [translationId], references: [id])
  name          String           // "Génesis", "Éxodo"
  abbreviation  String           // "Gen", "Ex"
  testament     String           // "AT" o "NT"
  order         Int              // 1 a 66
  chapters      BibleChapter[]

  @@unique([translationId, name])
}

model BibleChapter {
  id       String       @id @default(uuid())
  bookId   String
  book     BibleBook    @relation(fields: [bookId], references: [id])
  number   Int          // 1, 2, 3...
  verses   BibleVerse[]

  @@unique([bookId, number])
}

model BibleVerse {
  id        String       @id @default(uuid())
  chapterId String
  chapter   BibleChapter @relation(fields: [chapterId], references: [id])
  number    Int          // 1, 2, 3...
  text      String       // El texto del versículo

  @@unique([chapterId, number])
}

model YouTubeVideo {
  id              String    @id @default(uuid())
  videoId         String    @unique
  channelId       String
  title           String
  status          String    @default("RECEIVED")
  duration        Int?
  publishedAt     DateTime?
  localPath       String?
  azuracastFileId String?
  azuracastPath   String?
  attempts        Int       @default(0)
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  jobs            ProcessingJob[]
}

model YouTubeSubscription {
  id          String    @id @default(uuid())
  channelId   String    @unique
  subscribedAt DateTime @default(now())
  expiresAt   DateTime?
  active      Boolean   @default(true)
  updatedAt   DateTime  @updatedAt
}

model WorkerNode {
  id           String        @id @default(uuid())
  workerId     String        @unique
  name         String
  status       String        @default("OFFLINE")
  currentJobId String?
  lastSeenAt   DateTime?
  registeredAt DateTime      @default(now())
  jobs         ProcessingJob[]
}

model ProcessingJob {
  id         String      @id @default(uuid())
  videoId    String
  video      YouTubeVideo @relation(fields: [videoId], references: [videoId])
  workerId   String?
  worker     WorkerNode? @relation(fields: [workerId], references: [workerId])
  status     String      @default("PENDING")
  attempts   Int         @default(0)
  lastError  String?
  startedAt  DateTime?
  finishedAt DateTime?
  deadlineAt DateTime?
  nextRetryAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([deadlineAt])
  @@index([nextRetryAt])
}

model AnnouncementTemplate {
  id            String           @id @default(uuid())
  type          String           // 'hourly', 'greeting', 'custom'
  name          String
  textTemplate  String           @map("text_template")
  voice         String           @default("ef_dora")
  speed         Float            @default(0.85)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  
  generatedAudios GeneratedAudio[]
  
  @@map("announcement_templates")
}

model GeneratedAudio {
  id            String   @id @default(uuid())
  templateId    String   @map("template_id")
  template      AnnouncementTemplate @relation(fields: [templateId], references: [id])
  
  filename      String   @unique
  filepath      String
  textRendered  String   @map("text_rendered")
  durationMs    Int?     @map("duration_ms")
  fileSizeBytes Int?     @map("file_size_bytes")
  voice         String
  
  azuracastMediaId String? @map("azuracast_media_id")
  
  generatedAt   DateTime @default(now()) @map("generated_at")
  validUntil    DateTime? @map("valid_until")
  status        String   @default("ready") // 'ready', 'pending', 'error', 'expired'
  
  // Track which hour this audio represents (e.g., "14" for 2 PM)
  hourValue     Int?     @map("hour_value")
  
  // Track which time slot group this belongs to for reuse
  timeSlotGroup String?  @map("time_slot_group") // 'morning', 'afternoon', 'evening', 'night'
  
  // Usage tracking to prevent consecutive-day same-hour repetition
  lastUsedAt    DateTime? @map("last_used_at")
  lastUsedDate  DateTime? @map("last_used_date") // Date only, no time
  useCount      Int       @default(0) @map("use_count")
  
  schedules     AudioSchedule[]
  
  @@map("generated_audios")
  @@index([hourValue])
  @@index([timeSlotGroup])
  @@index([status])
  @@index([lastUsedDate])
}

model AudioSchedule {
  id              String   @id @default(uuid())
  audioId         String   @map("audio_id")
  audio           GeneratedAudio @relation(fields: [audioId], references: [id])
  
  // Target date and hour for playback
  scheduledDate   DateTime @map("scheduled_date") // Date only
  scheduledHour   Int      @map("scheduled_hour") // 0-23
  
  // Scheduling metadata
  cronExpression  String?  @map("cron_expression")
  azuracastPlaylistId String? @map("azuracast_playlist_id")
  
  enabled         Boolean  @default(true)
  playedAt        DateTime? @map("played_at")
  
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@unique([scheduledDate, scheduledHour])
  @@map("audio_schedules")
  @@index([scheduledDate])
  @@index([scheduledHour])
  @@index([enabled])
}

model GenerationLog {
  id              String   @id @default(uuid())
  jobType         String   @map("job_type") // 'scheduled', 'on_demand', 'hourly_check'
  status          String   @default("running") // 'running', 'success', 'partial', 'error'
  details         String?
  audiosGenerated Int?     @map("audios_generated")
  durationMs      Int?     @map("duration_ms")
  startedAt       DateTime @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@map("generation_logs")
  @@index([startedAt])
}

model ScheduleCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String   @default("#4f98a3")
  icon        String   @default("radio")
  keywords    String   @default("") // Comma-separated title matches, e.g. "REV JOSE SOTO,REV J. SOTO"
  isVisible   Boolean  @default(true) @map("is_visible")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("schedule_categories")
  @@index([isVisible])
  @@index([sortOrder])
}

model Device {
  id            String    @id @default(uuid())
  deviceId      String    @unique
  fcmToken      String?
  platform      String?
  appVersion    String?
  subscriptions String? // JSON array of subscribed program titles
  // Administrative zone assigned to this device (e.g. a city or region).
  // Used to segment push notifications without requesting device location.
  zoneId        String?
  // Provenance of the zone: MANUAL when set by admin/user, otherwise the
  // GeoIP provider that auto-assigned it (MAXMIND, IPWHOIS, IPAPI_CO, etc.).
  // Null means unknown/legacy records created before this field existed.
  zoneSource    String?   @map("zone_source")
  zoneAssignedAt DateTime? @map("zone_assigned_at")
  // Optional diagnostic fields populated on auto-assign (city -> zoneId).
  zoneRegion    String?   @map("zone_region")
  zoneCountry   String?   @map("zone_country")
  // Last public IP observed for this device. Stored to allow bulk zone
  // recalculation from the admin panel without requiring a new request
  // from each device. Only the IP string is stored, not geodata.
  lastIp        String?   @map("last_ip")
  lastIpAt      DateTime? @map("last_ip_at")
  lastSeen      DateTime  @default(now())
  createdAt     DateTime  @default(now())

  prayerRequests PrayerRequest[]

  @@map("devices")
  @@index([deviceId])
  @@index([fcmToken])
  @@index([zoneId])
  @@index([zoneSource])
  @@index([lastIp])
}

// History of custom push notifications sent from the admin panel.
model PushNotificationLog {
  id            String   @id @default(uuid())
  title         String
  body          String
  // Audience kind used to pick recipients: all, devices, zone, platform, program, active
  audience      String
  // JSON-encoded filters that were applied to select the recipients
  filters       String?
  targetedCount Int      @default(0)
  sentCount     Int      @default(0)
  failedCount   Int      @default(0)
  invalidTokens Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("push_notification_logs")
  @@index([createdAt])
}

model ProgramNotification {
  id             String   @id @default(uuid())
  programId      String   @map("program_id")
  startTimestamp DateTime @map("start_timestamp")
  notifiedAt     DateTime @default(now()) @map("notified_at")

  @@unique([programId, startTimestamp])
  @@map("program_notifications")
  @@index([startTimestamp])
}

// Muestreo periódico de oyentes para la gráfica del dashboard admin.
// El job de muestreo guarda un punto cada 5 minutos.
model ListenerSnapshot {
  id         String   @id @default(uuid())
  // Oyentes conectados en el momento del muestreo
  current    Int      @default(0)
  // Oyentes únicos (ventana de 24h reportada por AzuraCast)
  unique     Int      @default(0)
  // Oyentes totales (ventana reportada por AzuraCast)
  total      Int      @default(0)
  recordedAt DateTime @default(now())

  @@map("listener_snapshots")
  @@index([recordedAt])
}

// Rotación automática de playlists: copia cada día los siguientes N audios de una
// playlist fuente (en orden) hacia una playlist destino que se reproduce de forma
// secuencial. Es la base de la lectura bíblica programada y de rotaciones generales.
model PlaylistRotation {
  id               String   @id @default(uuid())
  name             String
  // Fuente del material ordenado: 'playlist' (playlist de AzuraCast) o 'folder' (carpeta de la biblioteca)
  sourceType       String   @default("playlist") @map("source_type")
  // Playlist de AzuraCast que contiene el material ordenado (solo si sourceType = 'playlist')
  sourcePlaylistId Int      @map("source_playlist_id")
  // Carpeta de la biblioteca de AzuraCast (solo si sourceType = 'folder')
  sourceFolder     String?  @map("source_folder")
  // Playlist de AzuraCast que se reconstruye cada día con los audios elegidos
  targetPlaylistId Int      @map("target_playlist_id")
  // Cuántos audios se colocan en cada ejecución (ej: 7 capítulos)
  itemsPerDay      Int      @default(7) @map("items_per_day")
  // Posición (0-based) en la playlist fuente desde donde se toma el siguiente bloque
  cursor           Int      @default(0)
  // Si es false, la rotación se detiene al llegar al final de la fuente
  loop             Boolean  @default(true)
  active           Boolean  @default(true)
  // Modo bíblico: la fuente está ordenada por capítulos, para publicar la lectura
  // del día y notificar a los suscriptores del programa
  bibleMode        Boolean  @default(false) @map("bible_mode")
  translation      String? // Ej: "RVR1960"
  // Ordinal del primer capítulo de la fuente (permite empezar en un punto distinto)
  bibleStartOrdinal Int     @default(1) @map("bible_start_ordinal")
  // Notificaciones push a los dispositivos suscritos al programa
  notifyEnabled    Boolean  @default(false) @map("notify_enabled")
  notifyProgram    String?  @map("notify_program")
  lastRunAt        DateTime? @map("last_run_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  runs RotationRunLog[]

  @@map("playlist_rotations")
  @@index([active])
}

// Historial de cada ejecución de una rotación.
model RotationRunLog {
  id          String           @id @default(uuid())
  rotationId  String           @map("rotation_id")
  rotation    PlaylistRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  runDate     DateTime         @default(now()) @map("run_date")
  status      String // 'success', 'partial', 'error'
  itemsPicked Int              @default(0) @map("items_picked")
  itemsPlaced Int              @default(0) @map("items_placed")
  // JSON con los títulos colocados y, en modo bíblico, los capítulos del día
  details     String?
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("rotation_run_logs")
  @@index([rotationId])
  @@index([runDate])
}

model PrayerRequest {
  id         String    @id @default(uuid())
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [deviceId])
  name       String
  request    String
  estado     String    @default("PENDIENTE")
  respuesta  String?
  answeredAt DateTime?
  readAt     DateTime?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("prayer_requests")
  @@index([deviceId])
  @@index([createdAt])
  @@index([estado])
}

// In-app notice for web and mobile — not a push notification, queried and displayed inside the UI with time window and per-user limits.
model AppNotice {
  id                  String   @id @default(uuid())
  title               String
  body                String
  imageUrl            String?  @map("image_url") // deprecated: use galleryItems
  videoUrl            String?  @map("video_url") // deprecated: use galleryItems
  ctaLabel            String?  @map("cta_label")
  ctaUrl              String?  @map("cta_url")
  variant             String   @default("info") // info | event | warning | prayer
  audience            String   @default("all") // all | zone | platform | program | devices
  audienceZoneId      String?  @map("audience_zone_id")
  audiencePlatform    String?  @map("audience_platform")
  audienceProgram     String?  @map("audience_program")
  audienceDeviceIds   String?  @map("audience_device_ids") // JSON array when audience=devices
  displayMode         String   @default("toast") @map("display_mode") // toast | modal — modal is intrusivo centrado al entrar
  startsAt            DateTime @map("starts_at")
  endsAt              DateTime @map("ends_at")
  maxDisplaysPerUser  Int      @default(3) @map("max_displays_per_user") // 0 = ilimitado
  dismissible         Boolean  @default(true)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  galleryItems        NoticeGalleryItem[]

  @@map("app_notices")
  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
  @@index([audience])
}

// Reusable image library for notices — optimized with sharp
model NoticeImage {
  id           String   @id @default(uuid())
  filename     String   @unique // uuid.webp en disco
  originalName String   @map("original_name")
  url          String   // /media/notices/<filename>
  mimeType     String   @map("mime_type")
  size         Int      // bytes optimizados
  width        Int?
  height       Int?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("notice_images")
  @@index([createdAt])
}

// Reusable video library for notices — optimized to 720p H.264 with poster thumbnail
model NoticeVideo {
  id           String   @id @default(uuid())
  filename     String   @unique // uuid.<ext> on disk
  originalName String   @map("original_name")
  url          String   // /media/notice-videos/<filename>
  posterUrl    String?  @map("poster_url") // /media/notice-videos/<poster>.webp
  mimeType     String   @map("mime_type")
  size         Int      // bytes after optimization
  width        Int?
  height       Int?
  durationMs   Int?     @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("notice_videos")
  @@index([createdAt])
}

// Carousel items for full-screen notices — supports multiple images/videos with ordering
model NoticeGalleryItem {
  id        String   @id @default(uuid())
  noticeId  String   @map("notice_id")
  notice    AppNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  type      String   // image | video
  url       String
  posterUrl String?  @map("poster_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notice_gallery_items")
  @@index([noticeId])
  @@index([sortOrder])
}
